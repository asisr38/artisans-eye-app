# Build context for the Next.js image: only what `pnpm run build` needs.

# Installed and generated locally; the image installs and builds its own.
node_modules
.next
out
*.tsbuildinfo
next-env.d.ts

# Never bake secrets or local tooling state into the image.
.env*
.vercel
.playwright-mcp
.git
.DS_Store
*.log

# Not part of the web build. The exported model and photographs the site
# serves live in public/artifacts; Blender sources, reference boards, docs and
# test scripts stay out of the context (assets/ alone is ~60 MB).
assets
docs
scripts
*.md

# Docker files themselves.
Dockerfile
docker-compose.yml
.dockerignore
