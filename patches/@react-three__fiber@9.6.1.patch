diff --git a/dist/timer-clock.cjs b/dist/timer-clock.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..89f0daf310269d4b62dea454df8f66ad5b511072
--- /dev/null
+++ b/dist/timer-clock.cjs
@@ -0,0 +1,49 @@
+// Preserve Fiber 9's public clock contract while computing time with Timer.
+// No document listeners: Fiber owns the render loop and pause/resume lifecycle.
+class TimerClock {
+  constructor(Timer, autoStart = true) {
+    this.Timer = Timer;
+    this.autoStart = autoStart;
+    this.startTime = 0;
+    this.oldTime = 0;
+    this.elapsedTime = 0;
+    this.running = false;
+    this.timer = new this.Timer();
+  }
+
+  start() {
+    this.timer = new this.Timer();
+    this.startTime = performance.now();
+    this.timer.update(this.startTime);
+    this.oldTime = this.startTime;
+    this.elapsedTime = 0;
+    this.running = true;
+  }
+
+  stop() {
+    this.getElapsedTime();
+    this.running = false;
+    this.autoStart = false;
+  }
+
+  getElapsedTime() {
+    this.getDelta();
+    return this.elapsedTime;
+  }
+
+  getDelta() {
+    if (this.autoStart && !this.running) {
+      this.start();
+      return 0;
+    }
+    if (!this.running) return 0;
+    const now = performance.now();
+    this.timer.update(now);
+    const delta = this.timer.getDelta();
+    this.oldTime = now;
+    this.elapsedTime += delta;
+    return delta;
+  }
+}
+
+module.exports = TimerClock;
